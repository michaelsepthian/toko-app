# Untuk go run di host, dengan PostgreSQL dari Docker pada port lokal 5433.
# Jika backend ikut Docker Compose, konfigurasi otomatis berasal dari .env.docker.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=toko
DB_USER=toko_app
DB_PASSWORD=toko_app_local_only
DB_SSLMODE=disable
HTTP_ADDR=127.0.0.1:8080
CORS_ORIGIN=http://localhost:3000
# TTL cache produk backend + frontend (detik), default 1 jam. Muat ulang tetap melewati cache.
PRODUCT_CACHE_TTL_SECONDS=3600

# Alternatif: DATABASE_URL lebih diutamakan daripada DB_* bila diisi.
# DATABASE_URL=postgresql://toko_app:PASSWORD@127.0.0.1:5433/toko?sslmode=disable
# Supabase atau database di jaringan luar: gunakan sslmode=require/verify-full.
# SUPABASE_URL dan SUPABASE_ANON_KEY hanya diperlukan untuk akun Supabase Auth lama.
