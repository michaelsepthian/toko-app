# Hanya contoh lokal. Ganti kedua password sebelum menjalankan di VPS.
# Gunakan quote tunggal untuk password yang mengandung $ atau #.
POSTGRES_DB=toko
POSTGRES_PASSWORD='toko_admin_local_only'
APP_DB_PASSWORD='toko_app_local_only'
DB_PORT_LOCAL=5433
API_PORT=8080
CORS_ORIGIN=http://localhost:3000
PRODUCT_CACHE_TTL_SECONDS=3600
API_IMAGE=toko-api:local
FRONTEND_IMAGE=toko-frontend:local
# VPS satu domain: hostname saja, tanpa https:// atau path.
# compose.vps.yaml mengatur CORS_ORIGIN otomatis ke https://APP_DOMAIN.
APP_DOMAIN=toko.example.com
